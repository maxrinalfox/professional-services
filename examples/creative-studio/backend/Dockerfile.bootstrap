# Minimal bootstrap image for database initialization only
# This image runs Alembic migrations and seed scripts
# It does NOT include the backend API server

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy from the cache instead of linking since it's a mounted volume
ENV UV_LINK_MODE=copy

# Copy dependency files first for layer caching
COPY uv.lock pyproject.toml /app/

# Install project dependencies using lockfile
RUN uv sync --locked --no-install-project --no-dev

# Copy project source code
COPY . /app

# Explicitly copy bootstrap assets with correct structure
# These are required for seed_vto_assets and seed_media_templates functions
COPY bootstrap/assets /app/bootstrap/assets/

# Install the project itself
RUN uv sync --locked --no-dev

# Install dependencies system-wide for the bootstrap container
# This ensures alembic and all its dependencies are available in PATH
RUN uv pip install --no-cache-dir --system -e .

# Reset entrypoint - don't invoke `uv`
ENTRYPOINT []

# Run complete bootstrap including migrations, admin user, and asset seeding
# The bootstrap.py script handles:
#   - Running Alembic migrations
#   - Creating admin user
#   - Creating default workspace
#   - Seeding VTO assets
#   - Seeding media templates
# DB_PASS will be provided as an environment variable via --set-secrets
CMD ["python", "-m", "bootstrap.bootstrap"]
