# ============================================================================
# TERRAFORM STATE BACKEND CONFIGURATION
# ============================================================================
#
# This file configures where Terraform stores its state file.
# The state file tracks all created resources and is CRITICAL for infrastructure management.
#
# IMPORTANT: Terraform CANNOT use variables in the backend configuration.
# Therefore, you must manually create this file for each environment.
#
# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# STEP 1: Create GCS Bucket for Terraform State
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Run these commands in your terminal:
#
#   # Set environment variables
#   export PROJECT_ID=your-gcp-project-id          # From: gcloud config get-value project
#   export ENVIRONMENT=dev                         # Or: staging, prod, sandbox, etc.
#
#   # Create a globally unique bucket name
#   # GCS bucket names must be UNIQUE across ALL of Google Cloud!
#   export BUCKET_NAME="${PROJECT_ID}-cstudio-${ENVIRONMENT}-tfstate"
#
#   # Create the bucket
#   gsutil mb -p $PROJECT_ID "gs://${BUCKET_NAME}"
#
#   # Enable versioning (recommended for state file safety)
#   gsutil versioning set on "gs://${BUCKET_NAME}"
#
#   # Set retention policy (optional - prevents accidental deletion)
#   # gsutil retention set 30d "gs://${BUCKET_NAME}"
#
# Example output:
#   Creating gs://my-project-cstudio-dev-tfstate/...
#   ServiceException: 409 Conflict: Bucket [my-project-cstudio-dev-tfstate] already exists.
#   (This is OK if the bucket already exists)
#
# STEP 2: Rename This File
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# This file must be renamed from "backend.tf.template" to "backend.tf" for Terraform to use it.
#
#   mv backend.tf.template backend.tf
#
# STEP 3: Update Bucket Name and Prefix
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Below, replace:
#   - BUCKET_NAME with your GCS bucket name (from STEP 1)
#   - PREFIX with your desired state path (usually "infra/{environment}/state")
#
# Example:
#   bucket = "my-project-cstudio-dev-tfstate"
#   prefix = "infra/dev/state"
#
# STEP 4: Initialize Terraform
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# After updating this file, run:
#
#   terraform init
#
# Terraform will:
#   1. Detect the backend configuration in this file
#   2. Create a remote state file in the GCS bucket
#   3. Download providers and modules
#
# ============================================================================
# WHY REMOTE STATE?
# ============================================================================
#
# Remote State Benefits:
# ✅ Shared: Multiple team members can work on the same infrastructure
# ✅ Safe: Prevents accidental local file deletion or corruption
# ✅ Secure: GCS handles encryption and access control
# ✅ Versioned: GCS bucket versioning prevents state corruption
# ✅ Locked: Terraform automatically locks state during operations
#
# State File Contents:
# - All resource IDs created in GCP
# - Resource configuration (as you defined it)
# - Resource metadata
# - Dependencies between resources
#
# WARNING: The state file contains sensitive information (passwords, API keys).
# ⚠️ NEVER commit backend.tf to version control if it contains real bucket names!
# Store in: .gitignore (see bottom of this file)
#
# ============================================================================
# DISASTER RECOVERY
# ============================================================================
#
# If state file is lost or corrupted:
#
# Option 1: Restore from GCS Versioning
#   gsutil ls -L "gs://BUCKET_NAME/infra/dev/state/default.tfstate"  # List versions
#   gsutil cp "gs://BUCKET_NAME/infra/dev/state/default.tfstate#VERSION_ID" local.tfstate
#
# Option 2: Refresh State from Actual Resources
#   terraform refresh  # Sync state with actual infrastructure
#
# Option 3: Recreate from Scratch (⚠️ DANGEROUS)
#   rm -f terraform.tfstate*
#   terraform init  # Re-create state from GCS
#   # Only do this if you're certain it's safe!
#
# ============================================================================
# BACKEND CONFIGURATION (UPDATE THE VALUES BELOW)
# ============================================================================

terraform {
  backend "gcs" {
    # REQUIRED: GCS bucket name for storing Terraform state
    # Pattern: ${PROJECT_ID}-cstudio-${ENVIRONMENT}-tfstate
    # Example: my-project-cstudio-dev-tfstate
    bucket = "CHANGE_ME_BUCKET_NAME"

    # REQUIRED: Path prefix within the bucket
    # Pattern: infra/${ENVIRONMENT}/state
    # Example: infra/dev/state
    # This allows multiple environments to share one bucket
    prefix = "infra/CHANGE_ME_ENVIRONMENT/state"
  }
}

# ============================================================================
# GIT IGNORE RULE
# ============================================================================
#
# Add this to your .gitignore to prevent accidental state file commits:
#
# # Terraform backend configuration with real bucket names (sensitive)
# backend.tf
# !backend.tf.template
#
# This ensures only the template is in version control, not the actual config.
#
# ============================================================================
